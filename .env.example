OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
LLM_PROVIDER=openai

# --- Local dev ---
# `npm run dev` serves /api/chat through the middleware in vite.config.js using
# the keys above (copy this file to .env.local and fill in OPENAI_API_KEY).
#
# --- Production ---
# The public chat backend runs as a Cloudflare Pages Function (functions/api/chat.js)
# on the SAME origin as the site, so no VITE_CHAT_API_URL is needed there. Set
# OPENAI_API_KEY (and optionally OPENAI_MODEL / LLM_PROVIDER) as encrypted
# environment variables in the Cloudflare Pages project settings — never commit them.
#
# Only set VITE_CHAT_API_URL if the site and backend live on DIFFERENT origins
# (e.g. keeping the site on GitHub Pages while the function is on Cloudflare):
# VITE_CHAT_API_URL=https://your-cloudflare-project.pages.dev/api/chat
