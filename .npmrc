; The project runs Vite 8, but @vitejs/plugin-react@4 only declares peer
; support up to Vite 7. The mismatch is advisory (the app builds fine), so we
; relax npm's strict peer-dependency check. This lets `npm ci` / `npm install`
; succeed without a manual --legacy-peer-deps flag on Cloudflare Pages and CI.
legacy-peer-deps=true
